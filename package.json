{
  "name": "ballast",
  "version": "0.1.0",
  "private": true,
  "description": "Cardano holders as Strike's second market maker: covered asks, proven on-chain and on L3",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "recorder": "tsx apps/recorder/src/main.ts",
    "recorder:verify": "tsx apps/recorder/src/verify.ts",
    "book-health": "tsx apps/cli/src/book-health.ts",
    "api:dev": "tsx watch apps/api/src/main.ts",
    "web:dev": "pnpm --filter @ballast/web run dev",
    "web:build": "pnpm --filter @ballast/web run build",
    "web:typecheck": "tsc --noEmit -p apps/web/tsconfig.json && tsc --noEmit -p apps/web/tsconfig.node.json",
    "ballast": "tsx apps/cli/src/main.ts",
    "verify": "tsx apps/cli/src/main.ts verify",
    "cover": "tsx apps/cli/src/main.ts cover",
    "dayone": "tsx apps/cli/src/main.ts dayone"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/node": "^26.1.2",
    "@types/ws": "^8.18.2",
    "fast-check": "^4.9.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
