# Ballast watchdog environment (host B). Copy to deploy/watchdog.env (gitignored) and chmod 600.
# It names key files, never keys. Empty means unset.
#
# HOSTING RULE: set BALLAST_ELIGIBLE_HOST=1 only after confirming this host is not in a
# Strike-restricted jurisdiction (https://www.strikefinance.org/restricted). No VPN or proxy.
BALLAST_ELIGIBLE_HOST=0

# Live cancels need DRY_RUN=false, BALLAST_ARM=1 and `--mainnet`; anything half-armed refuses.
DRY_RUN=true
BALLAST_ARM=0

# The keeper's daemon public key(s): only heartbeats signed by these keep the keeper "alive".
BALLAST_TRUSTED_DAEMONS=

# Accounts to guard (account id, stake address, r, sealed Strike key file used cancel-only).
BALLAST_WATCHDOG_ACCOUNTS_FILE=
BALLAST_KEK_PATH=data/keys/host.kek
BALLAST_WATCHDOG_DB=data/watchdog.sqlite
BALLAST_KILL_LOG=data/watchdog/kills.jsonl

# Heartbeat receiver: bind to the WireGuard address only. 10 s without a verified heartbeat fires.
BALLAST_HEARTBEAT_HOST=10.8.0.2
BALLAST_HEARTBEAT_PORT=9470
BALLAST_HEARTBEAT_DEADLINE_MS=10000

STRIKE_API_URL=https://api.strikefinance.org
STRIKE_WS_URL=wss://api.strikefinance.org
BALLAST_QUOTE_SYMBOL=NIGHT-USD
BALLAST_REPLICA_P99_BPS=0.77

KOIOS_URL=
KOIOS_TOKEN=

BALLAST_HEALTH_HOST=127.0.0.1
BALLAST_HEALTH_PORT=9465
BALLAST_DEADMAN_URL=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LOG_LEVEL=info
