# Ballast keeper environment (host A). Copy to deploy/keeper.env (gitignored) and chmod 600.
# It names key files, never keys. Empty means unset.
#
# HOSTING RULE: set BALLAST_ELIGIBLE_HOST=1 only after confirming this host is not in a
# Strike-restricted jurisdiction (https://www.strikefinance.org/restricted). No VPN or proxy.
BALLAST_ELIGIBLE_HOST=0

# Arming (invariant 3). Defaults: DRY_RUN=true, BALLAST_ARM=0. Arming also needs `--mainnet` on
# ExecStart; any half-armed combination refuses to start.
DRY_RUN=true
BALLAST_ARM=0

# The operator's Ed25519 public key(s) that sign policies (64 lowercase hex, comma-separated).
# Required when DRY_RUN=false.
BALLAST_OPERATOR_PUBKEYS=

# Keys at rest: the host KEK (0600, never in the repo), the sealed daemon key, the accounts file
# (account ids, stake addresses, r, caps, sealed Strike key files).
BALLAST_KEK_PATH=data/keys/host.kek
BALLAST_DAEMON_KEY_FILE=data/keys/daemon.json
BALLAST_ACCOUNTS_FILE=
BALLAST_DB_PATH=data/ballast.sqlite

# Signed policies (*.policy.json), Critic PASS reports (*.critic.json) and renewal envelopes
# (*.envelope.json) to load at start. A policy without a PASS report is sent to the Critic.
BALLAST_POLICY_DIR=
# Recordings for the Critic's replay (renewals). Without them the recorded scenarios cannot run
# and the Critic fails closed.
BALLAST_RECORDINGS=data/recordings
BALLAST_SIM_GIT_SHA=

# Strike (fixed when armed: https/wss on *.strikefinance.org only).
STRIKE_API_URL=https://api.strikefinance.org
STRIKE_WS_URL=wss://api.strikefinance.org
BALLAST_SYMBOLS=NIGHT-USD,ADA-USD
BALLAST_QUOTE_SYMBOL=NIGHT-USD
BALLAST_REPLICA_P99_BPS=0.77

# Cardano cover oracle (read-only). A Koios token is a secret: it is never logged.
KOIOS_URL=
KOIOS_TOKEN=

# Signed heartbeats every 2 s, pushed to the watchdog's receiver over WireGuard.
BALLAST_HEARTBEAT_URLS=http://10.8.0.2:9470/heartbeat
BALLAST_HEARTBEAT_FILE=

# Health endpoint (localhost only) and an optional healthchecks.io-style dead-man URL.
BALLAST_HEALTH_HOST=127.0.0.1
BALLAST_HEALTH_PORT=9464
BALLAST_DEADMAN_URL=

# Optional Telegram alerts (the token is scrubbed from every message and log line).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

BALLAST_WOULD_PLACE_LOG=data/keeper/would-place.jsonl
LOG_LEVEL=info
